        }
      ]
    },
    {
      "id": "claim_dfe83a5a95c04b828a3381cfb2f13a38",
      "statement": "The processor (queue-triggered Azure Container Apps job via KEDA scaler) handles one message per invocation: marks document processing, re-checks content hash, downloads bytes (Graph or filesystem per ADR-0020), extracts text, classifies with self-consistency voter, and UPSERTs result to PostgreSQL without overwriting manual classification_override; failures mark the row as failed and re-raise (chained) so the queue redelivers",
      "evidence": [
        {
          "resource": "repo://spec/spec.md#L28-L32",
          "version": "repo-lines-v1:sha256:4a3f97fa7c4b8db9e1cc0a1a54e1f6ac06438732970faeb3887c6a85e3496b94:"
