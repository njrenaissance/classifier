    {
      "id": "claim_3f15df8040d142edaa066af248496ef0",
      "statement": "The walker (scheduled Azure Container Apps job) enumerates a SharePoint library via Microsoft Graph delta queries under a time budget, persists resumable position as sync_state (delta_token, resume_token, completion status), and enqueues one work item per changed/new file; idempotency comes from content-hash comparison, preventing re-enqueue of in-flight or unchanged files",
      "evidence": [
        {
          "resource": "repo://spec/spec.md#L28-L32",
          "version": "repo-lines-v1:sha256:4a3f97fa7c4b8db9e1cc0a1a54e1f6ac06438732970faeb3887c6a85e3496b94:"
        },
