        }
      ]
    },
    {
      "id": "claim_30ae78e0d8f4445b84973098f2277fe9",
      "statement": "Enqueuer commits the Document row to queued status before enqueuing the message to Azure Queue; this ordering prevents duplicates if the queue send fails, leaving an at-most-once gap recoverable via pending reset.",
      "evidence": [
