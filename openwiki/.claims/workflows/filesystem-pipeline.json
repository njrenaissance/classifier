    {
      "id": "claim_2d3dc9fe736740d69c8befbd71046487",
      "statement": "Enqueuer is a shared source-neutral collaborator that applies identical enqueue-decision logic for both the Graph Walker and FilesystemWalker: new files enqueue, in-flight files skip, pending resets re-enqueue, unchanged hashes skip, changed hashes re-enqueue with hash rotation.",
      "evidence": [
        {
          "resource": "repo://src/enqueuer.py#L55-L103",
          "version": "repo-lines-v1:sha256:a038046ee97955261ad7f294c7638c9007351007991e04756f810dd9fff7b89e:"
