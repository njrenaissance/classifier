        }
      ]
    },
    {
      "id": "claim_f1025c9456084941886782e7b5a688df",
      "statement": "hash_bytes is a single shared function (sha256 hex digest) imported by both the filesystem producer at enqueue time and FilesystemContentSource at processor re-check time, ensuring producer and processor agree on content identity: matching hashes mean the file is unchanged, mismatches trigger re-enumeration.",
