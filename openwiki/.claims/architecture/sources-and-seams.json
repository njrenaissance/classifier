          "version": "repo-lines-v1:sha256:b80f567a8b36f546b52274b0d91eec9a76ec11744b8e28c32c443d480a391075:"
        }
      ]
    },
    {
      "id": "claim_0e3518f743c547d99ff264748677318e",
      "statement": "Walker (Graph producer) enumerates via Microsoft Graph delta pagination with resumable tokens, paginating within a time budget, extracting DocumentCandidate from each driveItem by parsing item.id, content hash, mime type, and folder path, then delegating enqueue decisions to Enqueuer.",
      "evidence": [
        {
          "resource": "repo://spec/adr/0014-sharepoint-delta-walker.md#L15-L30",
          "version": "repo-lines-v1:sha256:38fb30945984b9084b2605745a23ea06bda07f126aeead108160b3d7c092957c:"
