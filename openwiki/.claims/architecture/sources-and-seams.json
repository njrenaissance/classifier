        }
      ]
    },
    {
      "id": "claim_35fcd57877b7435da71760241e456972",
      "statement": "Message includes a source discriminator field (MessageSource enum: sharepoint or filesystem, default sharepoint) that self-describes message origin, enabling the processor to fail fast on misconfigured mixed queues where producer and consumer source modes do not match.",
