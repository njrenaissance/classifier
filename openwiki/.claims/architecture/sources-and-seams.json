  "claims": [
    {
      "id": "claim_f71eb296dba544cbb2dfbba03a112e88",
      "statement": "DocumentSource is a Protocol with a single method documents() -> Iterable[Path] that abstracts how the CLI discovers files to classify, enabling pluggable implementations for different sources (local filesystem, SharePoint, S3, etc.) without coupling the CLI to concrete enumeration logic.",
      "evidence": [
        {
          "resource": "repo://spec/adr/0010-uniform-document-source.md#L1-L20",
          "version": "repo-lines-v1:sha256:9a15c498905c1d70afa16bedf106c9107c0ab1f3d2c112552968ac2c58284709:"
        },
        {
          "resource": "repo://src/sources.py#L31-L34",
          "version": "repo-lines-v1:sha256:4cfafd9c8a37a9aadc42b89d4694a1ddecab272a04acc69e495efd94f85faf9d:"
        }
      ]
    },
    {
      "id": "claim_8b724d5b47ff4e9f9a3ff19f64a1861f",
      "statement": "LocalFileSystemSource implements DocumentSource by walking a local file or directory recursively, sorting results for determinism, filtering by supported file suffixes (reused from extraction.py to stay in sync), and skipping unsupported files with a WARNING log rather than failing.",
      "evidence": [
        {
          "resource": "repo://spec/adr/0010-uniform-document-source.md#L15-L20",
          "version": "repo-lines-v1:sha256:ebedd6135c9e42881650e70e8b776598de1fa0b0a2802f632c31c2849a3cc2a1:"
