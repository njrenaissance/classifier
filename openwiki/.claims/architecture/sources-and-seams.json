        }
      ]
    },
    {
      "id": "claim_09c8e1e47c5647e9b39332695ec84f0a",
      "statement": "GraphContentSource implements ContentSource by forwarding fetch_content_hash and download calls to the injected GraphClient, which handles Microsoft Graph authentication and download for SharePoint document retrieval.",
      "evidence": [
        {
          "resource": "repo://src/content_source.py#L52-L62",
          "version": "repo-lines-v1:sha256:8d97406a31578bf361c40b9ebe753e5d9f3f7365046111c72c36c89fcf1a027d:"
        }
      ]
    },
    {
      "id": "claim_1913c026e57f468cb0ca9767bd6ac6f5",
      "statement": "FilesystemContentSource implements ContentSource by resolving message.drive_item_id (a root-relative POSIX path) against the configured mount root, rejecting absolute paths and escape attempts (..) with SourceError, and reading file bytes from disk, with fetch_content_hash re-reading and hashing via the same hash_bytes function the producer used.",
      "evidence": [
        {
          "resource": "repo://spec/adr/0020-local-filesystem-source.md#L58-L67",
