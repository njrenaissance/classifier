        }
      ]
    },
    {
      "id": "claim_a49031d95d74469fae1cac0cdbdfea0f",
      "statement": "ContentSource is a Protocol with two methods (fetch_content_hash, download) that abstracts how the processor retrieves file bytes and re-validates content identity, enabling pluggable implementations (GraphContentSource for SharePoint, FilesystemContentSource for mounted filesystem) without coupling the processor to concrete retrieval logic.",
      "evidence": [
        {
          "resource": "repo://spec/adr/0020-local-filesystem-source.md#L46-L48",
          "version": "repo-lines-v1:sha256:87a0b5fd3de0552083e50459f5dc84834452bf36085009c108d2e3fdea9759dd:"
        },
        {
          "resource": "repo://src/content_source.py#L44-L49",
