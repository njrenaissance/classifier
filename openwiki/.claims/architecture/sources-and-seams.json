        }
      ]
    },
    {
      "id": "claim_e8e2f6ad1d8a41648cd510c690b76086",
      "statement": "DocumentCandidate is a frozen dataclass carrying source-neutral file identity (drive_item_id as locator, content_hash, mime_type, folder_path, file_name) produced by either Walker or FilesystemWalker and fed to the shared Enqueuer for idempotency decisions.",
      "evidence": [
        {
          "resource": "repo://src/enqueuer.py#L39-L53",
          "version": "repo-lines-v1:sha256:fe21d608e48acaf5d97493b48cdb82ee30e613afd0fe6dbcaa5da5155cf6cdca:"
        }
      ]
    },
    {
      "id": "claim_254a320622f14ea98655af2642d520ea",
      "statement": "Enqueuer applies uniform idempotency rules across both producers: enqueue new files, skip in-flight files (queued/processing), enqueue pending resets, enqueue changed files (rotating old hash to previous_hash), skip unchanged files, and never touch rows with manual classification_override.",
      "evidence": [
        {
          "resource": "repo://spec/adr/0020-local-filesystem-source.md#L36-L44",
          "version": "repo-lines-v1:sha256:4b2b840e44588c1679ac7429acf579ff3b2a164a58eb025b251f2cf601b03750:"
        },
        {
          "resource": "repo://src/enqueuer.py#L68-L102",
          "version": "repo-lines-v1:sha256:f8bfb1c64ac04b9548a5d0014d71bea6ca451c0c5fe844641cbaff249ca78f3a:"
        }
      ]
    },
    {
      "id": "claim_6b310946ca404128afca7617d8969bad",
      "statement": "Commit-before-enqueue is an invariant ordering in Enqueuer._queue_document: the documents row is committed to the database before the message is sent to the queue, so a rare queue send failure leaves an at-most-once gap (stuck queued row, recoverable via pending reset) rather than a duplicate message.",
      "evidence": [
        {
          "resource": "repo://spec/adr/0020-local-filesystem-source.md#L40-L44",
          "version": "repo-lines-v1:sha256:4f5b08c1508a51a847fce816936bc43f72c0595882c009a1b9b59b19a2fd6b99:"
        },
