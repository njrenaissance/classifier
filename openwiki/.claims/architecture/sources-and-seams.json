        }
      ]
    },
    {
      "id": "claim_f41ab21238044f52bf178d17641ade2a",
      "statement": "The cloud pipeline's two producers (Graph Walker and FilesystemWalker) do not use DocumentSource because they require custom per-source enumeration logic (delta pagination vs. full re-enumeration) and produce richer DocumentCandidate metadata that is captured at discovery time rather than lazy-evaluated.",
      "evidence": [
        {
          "resource": "repo://spec/adr/0020-local-filesystem-source.md#L16-L43",
          "version": "repo-lines-v1:sha256:52a85072bcf49728292fbdda8a59a7bff9bdc158debf8096eae5b4e76fcf500d:"
        },
        {
