        }
      ]
    },
    {
      "id": "claim_ba800466b98947bda973cbf5bbf968ea",
      "statement": "FilesystemWalker (filesystem producer) performs full re-enumeration on each run (no delta tokens, no time budget), using LocalFileSystemSource to walk the root and extracting DocumentCandidate by reading file bytes and hashing with hash_bytes (sha256), delegating enqueue decisions to the same Enqueuer so idempotency is identical to Graph path.",
      "evidence": [
        {
          "resource": "repo://spec/adr/0020-local-filesystem-source.md#L30-L67",
          "version": "repo-lines-v1:sha256:aaba49c74028461663782ab2731710b1e1483c25271cd4d7d6c1a51763878cf1:"
