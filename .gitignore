# Virtual environments
.venv/
venv/

# Python
__pycache__/
*.py[cod]

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/

# Linting & type-checking caches
.ruff_cache/
.mypy_cache/

# Environment variables
.env

# Build artifacts
dist/
build/
*.egg-info/

# Terraform (infra/terraform/). State must never be committed; the provider/module
# cache and crash logs are local artifacts. The dependency lock (.terraform.lock.hcl)
# is intentionally NOT ignored — it is committed so provider versions are pinned.
# Environment tfvars here hold no secrets (region, name prefix, tenant/client/drive
# ids), so environments/*.tfvars are committed; any stray *.auto.tfvars is not.
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.auto.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local-only operator runbook for the dev apply (E8, #46) — kept out of the repo
# on purpose; infra/terraform/README.md is the committed reference.
INSTRUCTIONS.md

# OpenWiki maintains an AGENTS.md (the non-Claude counterpart to CLAUDE.md);
# this project keeps it untracked so `openwiki code --update` (locally or in
# CI) never commits it. CLAUDE.md, by contrast, is tracked and its OPENWIKI
# block rides along in the docs PR.
AGENTS.md
