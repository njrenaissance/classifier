# Document source for the walker/processor: "sharepoint" (Graph delta, the default)
# or "filesystem" (a mounted directory, ADR-0020). The filesystem source needs
# CLASSIFIER__FILESYSTEM_ROOT below and no Graph credentials; sharepoint needs the
# Graph + walker settings further down. The local CSV CLI ignores this.
CLASSIFIER_SOURCE=sharepoint

# --- inference: TypeSafe Jev (ADR-0022) ---
# Required together. The endpoint is only known after early access, so there is no
# default. The SDK client is wired; a live run needs real credentials.
CLASSIFIER__JEV_API_KEY=your-jev-key-here
CLASSIFIER__JEV_BASE_URL=https://jev.example.com/v1

# --- cloud pipeline state store (ADR-0013) ---
# PostgreSQL connection URL. Required by the cloud path (walker/processor); the
# local CSV CLI does not use it.
CLASSIFIER__DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/classifier

# --- Microsoft Graph / SharePoint (ADR-0007/0015) ---
# App-only auth for the walker/processor. Choose one mode:
#   - set CLASSIFIER__GRAPH_USE_MANAGED_IDENTITY=true for managed identity / Entra ID (production), OR
#   - provide the client-credentials trio below (local dev / until a federated credential is configured).
# Startup fails if neither a managed identity nor the full trio is provided.
CLASSIFIER__GRAPH_USE_MANAGED_IDENTITY=false
CLASSIFIER__GRAPH_TENANT_ID=your-azure-ad-tenant-id
CLASSIFIER__GRAPH_CLIENT_ID=your-app-registration-client-id
CLASSIFIER__GRAPH_CLIENT_SECRET=your-app-registration-client-secret
# Graph token scope (optional). Default: https://graph.microsoft.com/.default
CLASSIFIER__GRAPH_TOKEN_SCOPE=https://graph.microsoft.com/.default
# Graph API base URL (optional). Default: https://graph.microsoft.com/v1.0
CLASSIFIER__GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# --- walker→processor work queue (ADR-0012/0014) ---
# Azure Queue Storage that decouples the two cloud jobs. The queue name is always
# required; choose one auth mode:
#   - provide CLASSIFIER__QUEUE_CONNECTION_STRING (local dev / Azurite), OR
#   - set CLASSIFIER__QUEUE_ACCOUNT_URL with CLASSIFIER__QUEUE_USE_MANAGED_IDENTITY=true (production).
# Startup fails if neither a connection string nor a managed-identity account URL is provided.
CLASSIFIER__QUEUE_NAME=classifier-work-items
CLASSIFIER__QUEUE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-account;AccountKey=your-key
CLASSIFIER__QUEUE_USE_MANAGED_IDENTITY=false
CLASSIFIER__QUEUE_ACCOUNT_URL=https://your-account.queue.core.windows.net

# --- walker job (ADR-0014/0019) ---
# The SharePoint drive (document library) the walker enumerates. Required by the
# walker; the processor and local CLI do not use it.
CLASSIFIER__WALKER_DRIVE_ID=your-sharepoint-drive-id
# Library subtree the walk is scoped to, enforced at the Graph delta level
# (ADR-0019). Default: /Matters. Set to / (or leave empty) to walk the whole
# drive. Point it at a small folder to run a live integration test against a
# subset of files, e.g. /Matters/Smith-2026-001.
CLASSIFIER__WALKER_ROOT_PATH=/Matters
# Per-run time budget in seconds (int > 0). A large first enumeration is resumed
# across scheduled slots rather than forced to finish in one. Default: 600 (10 min).
CLASSIFIER__WALKER_TIME_BUDGET_SECONDS=600

# --- filesystem source (ADR-0020) ---
# The mounted directory the walker enumerates and the processor reads from, used
# only when CLASSIFIER_SOURCE=filesystem. Enables live-fire testing against real
# files with no Graph/SharePoint. See infra/docker-compose.yml and infra/README.md.
CLASSIFIER__FILESYSTEM_ROOT=/data

# --- processor job (ADR-0012) ---
# Path to the category-definition Markdown the processor loads to build its voter.
# Required by the queue-triggered processor (which takes no CLI args); the walker
# and the local CSV CLI (which passes -c) do not use it.
CLASSIFIER__PROCESSOR_CATEGORY_FILE=categories.md
